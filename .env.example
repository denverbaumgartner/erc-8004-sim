# RPC URL to fork from (e.g., Ethereum mainnet, Sepolia, etc.)
FORK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# This is the Anvil RPC Endpoint
LOCAL_RPC_URL="http://127.0.0.1:8545"

# Private key for deploying contracts (without 0x prefix)
# WARNING: Never commit your actual private key to version control!
PRIVATE_KEY=your_private_key_here

# Set contract related env values for ChaosChain
LOCAL_ERC8004_V1_IDENTITY=""
LOCAL_ERC8004_V1_REPUTATION=""
LOCAL_ERC8004_V1_VALIDATION=""
LOCAL_USDC_TOKEN=""
LOCAL_TREASURY=""

# OpenRouter API key for DSPy agents
OPENROUTER_API_KEY=your_openrouter_api_key_here